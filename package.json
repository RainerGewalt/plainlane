{
  "name": "plainlane",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A small self-hosted Kanban board with files, comments, and optional AI web research",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:server\" \"npm:client\"",
    "server": "node server/index.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
