# Optional AI web research. Keep this server-side and never commit your real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Browser port used by Docker Compose.
PLAINLANE_PORT=8080

# Safe default: only this computer can reach Plainlane.
# Use 0.0.0.0 only on a trusted LAN; Plainlane has no login screen.
PLAINLANE_BIND_ADDRESS=127.0.0.1

# Create a rolling SQLite backup before startup migrations (1 = on, 0 = off).
PLAINLANE_AUTO_BACKUP=1

# Optional local server overrides. Docker Compose supplies its own values.
# PORT=3001
# HOST=127.0.0.1
# DB_PATH=server/plainlane.db
